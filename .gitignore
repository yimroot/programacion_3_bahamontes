# =======================================================================
# 🚀 FULL NODE.JS / NESTJS MONOREPO .GITIGNORE
# =======================================================================

# 📦 Dependencias
**/node_modules/
**/jspm_packages/
**/bower_components/

# 🔒 Entorno y Secretos (¡CRÍTICO!)
**/.env
**/.env.*
**/.env.*.local
!**/.env.example
!**/.env.template
**/*.pem
**/*.key
**/*.cert
**/*.crt
**/.aws/
**/.gcp/

# 🏗️ Compilación y TypeScript (NestJS)
**/dist/
**/build/
**/.nest/
**/out-tsc/
**/.tsbuildinfo
**/lib-cov/

# 🛠️ Logs y Archivos de Depuración
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*
**/.pnpm-debug.log*

# 🧪 Testing y Cobertura (Jest, E2E, Cypress)
**/coverage/
**/.nyc_output/
**/.tox/
**/.jest-cache/
**/puppeteer_crash*/
**/cypress/videos/
**/cypress/screenshots/
**/cypress/downloads/

# 📁 Herramientas de Monorepositorio y Caché
**/.nx/
**/.turbo/
**/.lerna/
**/node_modules/.cache/

# 💻 Sistemas Operativos
# -> macOS
**/.DS_Store
**/.DS_Store?
**/.AppleDouble
**/.LSOverride
**/Icon
**/.Trashes
**/.Spotlight-V100
**/.DocumentRevisions-V100
# -> Windows
**/Thumbs.db
**/Thumbs.db:encryptable
**/ehthumbs.db
**/ehthumbs_vista.db
**/*.stackdump
**/Desktop.ini
**/$RECYCLE.BIN/
# -> Linux
**/*~
**/.fuse_hidden*

# 📝 Editores e IDEs
# -> VS Code
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
!**/.vscode/launch.json
**/.history/
# -> IntelliJ / WebStorm (JetBrains)
**/.idea/
**/*.iws
**/*.iml
**/*.ipr
# -> Vim / Emacs
**/.*.swp
**/.*.swo
**/.#*
**/*#

# 🐳 Docker, Infraestructura y Serveless
**/.serverless/
**/.terraform/
**/.amplify/
**/docker-compose.override.yml
**/docker-compose.local.yml

# 🗑️ Temporales, PIDs y Caché de Linters
**/tmp/
**/temp/
**/.cache/
**/*.pid
**/*.seed
**/*.pid.lock
**/.eslintcache
**/.stylelintcache
**/.prettiercache